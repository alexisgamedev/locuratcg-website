# Culqi (https://culqi.com) — get these from your Culqi dashboard.
# Leave empty and the "Join" buttons will tell you checkout isn't configured.
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=

# Where the SQLite database lives (default: data/pullclub.db)
DATABASE_PATH=data/pullclub.db

# Public URL of the site, used in password-reset links
APP_URL=http://localhost:3000
